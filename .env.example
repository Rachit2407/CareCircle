# CareCircle AI Backend Environment Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Security & CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
JWT_SECRET=super-secret-carecircle-jwt-key-minimum-32-chars-long
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super-secret-carecircle-refresh-key-minimum-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/carecircle

# Storage Service (Supabase or AWS S3 Compatible)
STORAGE_BUCKET_NAME=carecircle-health-records
STORAGE_SIGNING_SECRET=secure-storage-signing-secret-key-32-chars
STORAGE_BASE_URL=https://storage.carecircle.internal
STORAGE_SIGNED_URL_EXPIRY_SECONDS=900

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
ALERT_RATE_LIMIT_MAX=5

# Voice & Notification Providers (Sarvam, SMS, Push)
SARVAM_API_KEY=mock-sarvam-key-for-dev
SARVAM_API_BASE_URL=https://api.sarvam.ai
REMINDER_WORKER_INTERVAL_MS=30000
REMINDER_MAX_ATTEMPTS=3

# Logging & Auditing
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
