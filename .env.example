# Mock mode: the app talks to src/services/mock instead of a backend.
VITE_USE_MOCKS=true
# Base path of the backend API (spec section 9 uses /api/v1).
VITE_API_BASE_URL=/api/v1
# Optional: request timeout in ms (default 15000). Lower it to demo the "unconfirmed" state faster,
# but keep it above 4000 or the mock "Slow" scenario (about 3.5 s) will time out instead.
VITE_API_TIMEOUT_MS=15000
# Never put provider secrets in VITE_* variables - they ship to the browser.
