# CareCircle AI Engine Environment Configuration

# Server Settings
PORT=8001
HOST=0.0.0.0
DEBUG=True

# LLM Provider (OpenAI compatible, Groq, Anthropic, or Local)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# Sarvam Voice API
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech

# MCP Server Connection
MCP_SERVER_URL=http://localhost:8000/mcp
MCP_TRANSPORT=sse

# Backend API Connection
BACKEND_API_BASE_URL=http://localhost:5000/api/v1
INTERNAL_SERVICE_TOKEN=carecircle_internal_secret_token
